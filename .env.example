# Zorunlu: tek gereken API anahtarı
ANTHROPIC_API_KEY=

# İsteğe bağlı
# Öğrencilere vereceğin erişim kodu (boşsa herkes kullanabilir)
ACCESS_CODE=
# Analiz modeli ve derinliği (low | medium | high | xhigh | max)
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
# Sonuçlar bellekte kaç dakika tutulsun
RESULT_TTL_MINUTES=120
# Aynı anda çalışabilecek analiz sayısı
MAX_CONCURRENT_JOBS=3
